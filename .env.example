# Copy to .env and adjust as needed. main.go reads these via os.Getenv
# (see internal/config/config.go), so `export`-ing them or using a tool
# like `direnv` / `docker compose --env-file` both work.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/orchestrator?sslmode=disable
HTTP_PORT=8080

# How often (seconds) the scheduler checks for due jobs.
POLL_INTERVAL_SECONDS=5

# Fixed advisory-lock key used for leader election. Any int64 works; it just
# needs to be the same across all instances of this service, and different
# from any other app sharing the same database that also uses advisory locks.
LEADER_LOCK_ID=8675309

# How often (seconds) a non-leader instance retries acquiring leadership,
# and how often the current leader verifies it still holds the lock.
LEADER_RETRY_SECONDS=3
